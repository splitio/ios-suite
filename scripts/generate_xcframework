#!/bin/zsh
set -euo pipefail
# Avoid clear errors on CI when TERM is not set
if [ -t 1 ]; then
  clear
fi
VERSION=$1
CUR_DIR=$(pwd)
PRODUCT_NAME=iOSSplitSuite
# Static lib schema
#SCHEMA_NAME=StaticiOSSplitSuite

# Dynamic lib schema
SCHEMA_NAME=iOSSplitSuite

BUILD_FOLDER=SplitBuild
FULL_BUILD_FOLDER="${CUR_DIR}/${BUILD_FOLDER}"
ARCHIVES_PATH="${FULL_BUILD_FOLDER}/archives"
XCF_FOLDER=xcframework
LICENSE_FILE=LICENSE

echo "-----------------------------------"
echo "This script must be run from the folder containing iOSSplitSuite.xcodeproj"
echo "Example: ./scripts/generate_xcframework"
echo "-----------------------------------"

echo "Building Split Suite Version ${VERSION}"

rm -rf "${CUR_DIR}/${BUILD_FOLDER}"
rm -rf "${CUR_DIR}/${XCF_FOLDER}"

mkdir -p "${CUR_DIR}/${BUILD_FOLDER}"
mkdir -p "${CUR_DIR}/${XCF_FOLDER}"
mkdir -p "${ARCHIVES_PATH}"

function build_framework {
    readonly DESTINATION=$1
    echo "Building ${PRODUCT_NAME} for ${DESTINATION}"
    local SDK_FLAG=""
    if [ "${DESTINATION}" = "iOS" ]; then
      SDK_FLAG="-sdk iphoneos"
    else
      SDK_FLAG="-sdk iphonesimulator"
    fi

    xcodebuild build    -project "${PRODUCT_NAME}.xcodeproj" \
                        -scheme "${SCHEMA_NAME}" \
                        -configuration Release \
                        -derivedDataPath "${FULL_BUILD_FOLDER}" \
                        -destination 18.4/platform="${DESTINATION}" \
                        ${SDK_FLAG} \
                        SKIP_INSTALL=NO \
                        BUILD_LIBRARIES_FOR_DISTRIBUTION=YES \
                        > /dev/null

    xcodebuild archive  -project "${PRODUCT_NAME}.xcodeproj" \
                        -scheme "${SCHEMA_NAME}" \
                        -configuration Release \
                        -derivedDataPath "${FULL_BUILD_FOLDER}" \
                        -destination 18.4/platform="${DESTINATION}" \
                        ${SDK_FLAG} \
                        -archivePath "${ARCHIVES_PATH}/${PRODUCT_NAME}-${DESTINATION// /_}.xcarchive" \
                        SKIP_INSTALL=NO \
                        BUILD_LIBRARIES_FOR_DISTRIBUTION=YES \
                        > /dev/null

}

build_framework "iOS"
build_framework "iOS Simulator"

#read -s -k "?Press any key to continue."

XCF_NAME_PATH="${CUR_DIR}/${XCF_FOLDER}/${PRODUCT_NAME}"
XCF_PATH="${XCF_NAME_PATH}.xcframework"
ZIP_PATH="${XCF_NAME_PATH}_${VERSION}.zip"

XCF_FOLDER="${CUR_DIR}/${XCF_FOLDER}"
XCF_NAME="${PRODUCT_NAME}.xcframework"
ZIP_NAME="${PRODUCT_NAME}_${VERSION}.zip"

#Creating XCFramework
echo "Creating XCFramework from ${BUILD_FOLDER} "
PRODUCTS_PATH="${CUR_DIR}/${BUILD_FOLDER}"
FRAMEWORK_FILE="${PRODUCT_NAME}.framework"
DSYM_FILE="${FRAMEWORK_FILE}.dSYM"

# Using archives 
xcodebuild  -create-xcframework \
            -archive "${ARCHIVES_PATH}/${PRODUCT_NAME}-iOS.xcarchive" -framework $FRAMEWORK_FILE \
            -archive "${ARCHIVES_PATH}/${PRODUCT_NAME}-iOS_Simulator.xcarchive" -framework $FRAMEWORK_FILE \
            -output "${XCF_PATH}" \
            > /dev/null

echo "Zipping file"
cp "${LICENSE_FILE}" "${XCF_FOLDER}"

cd "${XCF_FOLDER}"
zip -vrqD "${ZIP_NAME}" "${XCF_NAME}" "${LICENSE_FILE}"

CHECKSUM_FILE="${XCF_FOLDER}/checksum"

echo "Generating package checksum"
swift package compute-checksum "${ZIP_PATH}" > "${CHECKSUM_FILE}"

echo "Zip Checksum to put in Package.swift file:"
cat "${CHECKSUM_FILE}"

echo "Removing build folder"
rm -rf "${FULL_BUILD_FOLDER}"

echo "-----------------------------------"
echo "${PRODUCT_NAME} XCFramework is located in ${XCF_FOLDER}"
echo "-----------------------------------\n"