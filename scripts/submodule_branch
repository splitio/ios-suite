#!/bin/zsh
clear
CUR_DIR=$(pwd)
BRANCH_NAME=split_suite_0.1.0

cd "${CUR_DIR}/ios-client"
pwd
git branch
git fetch origin "${BRANCH_NAME}"
git fetch --all
git remote -v
git branch
git switch "${BRANCH_NAME}"
git switch split_suite_0.1.0

cd "${CUR_DIR}/ios-rum-agent"
git fetch origin "${BRANCH_NAME}"
git branch
git switch "${BRANCH_NAME}"